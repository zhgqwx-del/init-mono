+def optional_bool(query, name):
+    value = query_value(query, name, None)
+    if value is not None and value not in ("true", "false"):
+        raise ValueError(f"{name} must be true or false")
+    return value == "true"
+
+
+def remaining_capacity(port, token, ids):
+    if not ids:
+        return {}
+    request = Request(
+        f"http://127.0.0.1:{port}/internal/capacities?" + urlencode({"ids": ",".join(ids)}),
+        headers={"Authorization": token},
+    )
+    with urlopen(request, timeout=2) as response:
+        data = json.load(response)
+    items = data["items"]
+    if not isinstance(items, list):
+        raise ValueError("invalid capacity response")
+    remaining = {}
+    for item in items:
+        if not isinstance(item, dict) or not isinstance(item.get("id"), str):
+            raise ValueError("invalid capacity record")
+        value = item.get("remaining")
+        if type(value) is not int or value < 0 or item["id"] in remaining:
+            raise ValueError("invalid remaining capacity")
+        remaining[item["id"]] = value
+    if set(remaining) != set(ids):
+        raise ValueError("capacity response does not cover requested activities")
+    return remaining
+
+
